   "source": [
    "support_files = [name for name in EXPECTED_FILES if name != MAIN_FILE]\n",
    "\n",
    "key_map = {\n",
    "    \"GlobalLandTemperaturesByCountry.csv\": [\"dt\", \"Country\"],\n",
    "    \"GlobalLandTemperaturesByMajorCity.csv\": [\n",
    "        \"dt\", \"City\", \"Country\", \"Latitude\", \"Longitude\"\n",
    "    ],\n",
    "    \"GlobalLandTemperaturesByState.csv\": [\"dt\", \"State\", \"Country\"],\n",
    "    \"GlobalTemperatures.csv\": [\"dt\"],\n",
    "}\n",
    "\n",
    "support_overview_rows = []\n",
    "support_numeric_rows = []\n",
    "support_category_rows = []\n",
    "support_domains = {}\n",
    "\n",
    "for file_name in support_files:\n",
    "    file_path = DATA_RAW_DIR / file_name\n",
    "    aux_df = pd.read_csv(file_path, parse_dates=[\"dt\"], low_memory=False)\n",
    "\n",
    "    support_overview_rows.append(\n",
    "        {\n",
    "            \"file\": file_name,\n",
    "            \"rows\": len(aux_df),\n",
    "            \"columns\": aux_df.shape[1],\n",
    "            \"memory_mb\": aux_df.memory_usage(deep=True).sum() / 1024**2,\n",
    "            \"missing_cells\": int(aux_df.isna().sum().sum()),\n",
    "            \"full_duplicates\": int(aux_df.duplicated().sum()),\n",
    "            \"key_duplicates\": int(aux_df.duplicated(subset=key_map[file_name]).sum()),\n",
    "            \"min_date\": aux_df[\"dt\"].min(),\n",
    "            \"max_date\": aux_df[\"dt\"].max(),\n",
    "            \"dtypes\": \", \".join(\n",
    "                f\"{dtype}: {count}\"\n",
    "                for dtype, count in aux_df.dtypes.astype(str).value_counts().items()\n",
    "            ),\n",
    "        }\n",
    "    )\n",
    "\n",
    "    for column in aux_df.select_dtypes(include=\"number\").columns:\n",
    "        values = aux_df[column]\n",
    "        support_numeric_rows.append(\n",
    "            {\n",
    "                \"file\": file_name,\n",
    "                \"column\": column,\n",
    "                \"count\": values.count(),\n",
    "                \"mean\": values.mean(),\n",
    "                \"median\": values.median(),\n",
    "                \"std\": values.std(),\n",
    "                \"min\": values.min(),\n",
    "                \"max\": values.max(),\n",
    "            }\n",
    "        )\n",
    "\n",
    "    for column in aux_df.select_dtypes(include=[\"object\", \"string\", \"category\"]).columns:\n",
    "        counts = aux_df[column].value_counts(dropna=False)\n",
    "        support_category_rows.append(\n",
    "            {\n",
    "                \"file\": file_name,\n",
    "                \"column\": column,\n",
    "                \"groups\": aux_df[column].nunique(dropna=True),\n",
    "                \"top_value\": counts.index[0] if len(counts) else None,\n",
    "                \"top_count\": counts.iloc[0] if len(counts) else 0,\n",
    "            }\n",
    "        )\n",
    "\n",
    "    support_domains[file_name] = {\n",
    "        \"dates\": set(aux_df[\"dt\"].dropna().unique()),\n",
    "        \"countries\": (\n",
    "            set(aux_df[\"Country\"].dropna().unique())\n",
    "            if \"Country\" in aux_df.columns else set()\n",
    "        ),\n",
    "    }\n",
    "\n",
    "    if file_name == \"GlobalLandTemperaturesByMajorCity.csv\":\n",
    "        support_domains[file_name][\"locations\"] = set(\n",
    "            aux_df[[\"City\", \"Country\", \"Latitude\", \"Longitude\"]]\n",
    "            .drop_duplicates()\n",
    "            .itertuples(index=False, name=None)\n",
    "        )\n",
    "\n",
    "    del aux_df\n",
    "    gc.collect()\n",
    "\n",
    "support_overview = pd.DataFrame(support_overview_rows)\n",
    "support_numeric = pd.DataFrame(support_numeric_rows)\n",
    "support_category = pd.DataFrame(support_category_rows)\n",
    "\n",
    "display(support_overview)\n"
   ]
