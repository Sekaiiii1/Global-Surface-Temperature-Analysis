    "def count_csv_rows(file_path, chunk_size=1_000_000):\n",
    "    \"\"\"Đếm số dòng dữ liệu bằng cách chỉ đọc cột đầu theo từng phần.\"\"\"\n",
    "    chunks = pd.read_csv(file_path, usecols=[0], chunksize=chunk_size)\n",
    "    return sum(len(chunk) for chunk in chunks)\n",
    "\n",
    "\n",
    "catalog_rows = []\n",
    "\n",
    "for file_name in EXPECTED_FILES:\n",
    "    file_path = DATA_RAW_DIR / file_name\n",
    "    columns = pd.read_csv(file_path, nrows=0).columns.tolist()\n",
    "\n",
    "    catalog_rows.append(\n",
    "        {\n",
    "            \"file\": file_name,\n",
    "            \"rows\": count_csv_rows(file_path),\n",
    "            \"columns\": len(columns),\n",
    "            \"size_mb\": file_path.stat().st_size / 1024**2,\n",
    "            \"column_names\": \", \".join(columns),\n",
    "            \"role\": \"Main fact table\" if file_name == MAIN_FILE else \"Supporting fact table\",\n",
    "        }\n",
    "    )\n",
    "\n",
    "file_catalog = pd.DataFrame(catalog_rows)\n",
    "display(file_catalog)\n"
