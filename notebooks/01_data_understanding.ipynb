    "def coordinate_to_number(value):\n",
    "    \"\"\"Đổi '57.05N' thành 57.05 và '3.23W' thành -3.23.\"\"\"\n",
    "    number = float(value[:-1])\n",
    "    direction = value[-1]\n",
    "    return -number if direction in {\"S\", \"W\"} else number\n",
    "\n",
    "\n",
    "latitude_num = city_df[\"Latitude\"].map(coordinate_to_number).astype(\"float32\")\n",
    "longitude_num = city_df[\"Longitude\"].map(coordinate_to_number).astype(\"float32\")\n",
    "\n",
    "logic_summary = pd.Series(\n",
    "    {\n",
    "        \"Ngày không hợp lệ\": int(city_df[\"dt\"].isna().sum()),\n",
    "        \"Uncertainty âm\": int((city_df[\"AverageTemperatureUncertainty\"] < 0).sum()),\n",
    "        \"Nhiệt độ ngoài [-90, 60] °C\": int(\n",
    "            ((city_df[\"AverageTemperature\"] < -90) |\n",
    "             (city_df[\"AverageTemperature\"] > 60)).sum()\n",
    "        ),\n",
    "        \"Vĩ độ ngoài [-90, 90]\": int(((latitude_num < -90) | (latitude_num > 90)).sum()),\n",
    "        \"Kinh độ ngoài [-180, 180]\": int(\n",
    "            ((longitude_num < -180) | (longitude_num > 180)).sum()\n",
    "        ),\n",
    "    },\n",
    "    name=\"Số bản ghi\",\n",
    ")\n",
    "\n",
    "display(logic_summary.to_frame())\n"
   ]
  },
